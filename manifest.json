{
  "manifest_version": 3,
  "name": "Bulk Link Sender to Telegram",
  "version": "1.0.0",
  "description": "Grab active tab URLs, organize links in a table, and send them to Telegram individually or in bulk per message bubble.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Bulk Link Sender to Telegram"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://api.telegram.org/*"
  ],
  "options_ui": {
    "page": "manager/manager.html",
    "open_in_tab": true
  },
  "commands": {
    "grab-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Quickly grab and save current tab URL"
    }
  }
}
